# Copie para .env e preencha. Nunca faça commit do .env.

# Banco
MONGODB_URI=mongodb://localhost:27017/PAIRUP

# Autenticação
# JWT_SECRET: mínimo de 32 bytes, aleatório. Gere com: openssl rand -base64 48
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URLs
# FRONTEND_URL: uma única URL
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
PORT=8080

# Cloudflare R2
# CF_R2_PUBLIC_URL: necessária para mostrar as fotos no feed antes do match
CF_R2_ENDPOINT=
CF_R2_ACCESS_KEY=
CF_R2_SECRET_KEY=
CF_R2_BUCKET=
CF_R2_PUBLIC_URL=

# E-mail de aviso de match (opcional: sem MAIL_HOST ou MAIL_FROM nada é enviado)
# Exemplo com Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PASSWORD com uma senha de app
# e MAIL_FROM com o mesmo endereço de MAIL_USERNAME
MAIL_HOST= smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Segurança
# Origens do front autorizadas no CORS (separadas por vírgula, sem "*")
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Swagger/OpenAPI: deixe false em produção
SWAGGER_ENABLED=false
# Limites por IP por minuto
RATE_LIMIT_AUTH=10
RATE_LIMIT_GERAL=300

# Docker compose: senha obrigatória do MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
